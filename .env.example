# ==========================================================================
# CoreGen Biyoteknoloji — Ortam Değişkenleri Örneği
# Bu dosyayı kopyalayıp ".env" olarak kaydedin ve gerçek değerlerle doldurun.
# ".env" dosyası .gitignore içinde olduğu için repoya asla eklenmemelidir.
# ==========================================================================

# --- Veritabanı ---------------------------------------------------------
# PostgreSQL bağlantı adresi (ör. Supabase / Neon / Railway / yerel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/coregen?schema=public"

# --- Uygulama -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- E-posta (sağlayıcı kararı netleştiğinde doldurulacak) ----------------
# EMAIL_FROM="teklif@coregenbiyoteknoloji.com"
# RESEND_API_KEY=""

# --- Admin Auth (geçici tek-kullanıcı çözümü — Veritabanı Şeması adımında ---
# --- NextAuth.js + Prisma User modeline geçilecek) --------------------------
ADMIN_EMAIL="admin@coregenbiyoteknoloji.com"
ADMIN_PASSWORD="degistirin-guclu-bir-sifre-secin"
# openssl rand -base64 32 ile üretilebilir — rastgele, uzun, gizli tutulmalı
ADMIN_SESSION_SECRET="degistirin-rastgele-uzun-bir-anahtar"

# --- Dosya/Görsel Depolama (sağlayıcı kararı netleştiğinde doldurulacak) --
# BLOB_READ_WRITE_TOKEN=""
